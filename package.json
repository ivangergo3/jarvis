{
  "name": "jarvis-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.7.1",
  "engines": {
    "node": "24.19.0",
    "pnpm": "10.7.1"
  },
  "scripts": {
    "build": "TURBO_TELEMETRY_DISABLED=1 turbo run build --cache=local:rw",
    "typecheck": "TURBO_TELEMETRY_DISABLED=1 turbo run typecheck --cache=local:rw",
    "fixture": "TURBO_TELEMETRY_DISABLED=1 turbo run build --filter=@jarvis/workspace-fixture --cache=local:rw && node fixtures/verify-workspace.mjs"
  },
  "devDependencies": {
    "@jarvis/workspace-fixture": "workspace:*",
    "turbo": "2.11.13",
    "typescript": "6.0.3"
  }
}
