{
  "name": "jarvis-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.7.1",
  "engines": {
    "node": "24.19.0",
    "pnpm": "10.7.1"
  },
  "scripts": {
    "build": "node scripts/run-workspace.mjs build",
    "typecheck": "node scripts/run-workspace.mjs typecheck",
    "fixture": "node scripts/run-workspace.mjs fixture",
    "check:packages": "node scripts/typescript/package-graph.mjs && node --test scripts/typescript/package-graph.test.mjs",
    "lint": "node scripts/typescript/lint.mjs && node --test scripts/typescript/lint.test.mjs",
    "format:check": "node scripts/typescript/format.mjs && node --test scripts/typescript/format.test.mjs",
    "check:style": "pnpm typecheck && node --test scripts/typescript/check-source-types.test.mjs && pnpm check:packages && pnpm lint && pnpm format:check",
    "test": "vitest run"
  },
  "devDependencies": {
    "@jarvis/workspace-fixture": "workspace:*",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.10.1",
    "turbo": "2.11.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1",
    "yaml": "2.9.1"
  }
}
